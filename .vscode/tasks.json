{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      },
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "build:watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild-watch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[watch\\] build started",
          "endsPattern": "\\[watch\\] build finished"
        }
      },
      "label": "npm: build:watch"
    }
  ]
}
