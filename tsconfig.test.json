{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "out"
  },
  "include": [
    "src/util/**/*.ts",
    "src/parse/**/*.ts",
    "src/model/**/*.ts",
    "src/discovery/**/*.ts",
    "src/services/**/*.ts",
    "src/test/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "dist"]
}
